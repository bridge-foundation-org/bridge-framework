# Bridge Framework — Environment Configuration
# Copy this file to .env and customize as needed

# Daemon TCP address (for CLI communication)
BRIDGE_TCP_ADDR=127.0.0.1:7878

# Daemon HTTP address (for frontend and API calls)
BRIDGE_HTTP_ADDR=127.0.0.1:8787

# Miniredis address
BRIDGE_REDIS_ADDR=127.0.0.1:6399

# Docker Postgres settings (managed by daemon)
BRIDGE_POSTGRES_PASSWORD=bridge
BRIDGE_POSTGRES_PORT=5432

# External Postgres (if using docker-compose instead)
# DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge_dev

# External Redis (if not using embedded miniredis)
# REDIS_URL=redis://localhost:6379

# Daemon mode (lite | full | ultra | off)
BRIDGE_MODE=full

# Enable verbose logging (for debugging)
# RUST_LOG=debug
