# Bridge Framework — Environment Configuration
# Copy this file to .env and customise as needed.
# docker-compose and the Bridge daemon both read from .env automatically.

# ── Bridge Daemon ───────────────────────────────────────────────────────────────

# TCP address used by the CLI to talk to the daemon
BRIDGE_TCP_ADDR=127.0.0.1:7878

# HTTP address for the REST API and dev dashboard
BRIDGE_HTTP_ADDR=127.0.0.1:8787

# Miniredis address (embedded Redis-compatible cache)
BRIDGE_REDIS_ADDR=127.0.0.1:6399

# Daemon mode: lite | full | ultra | off
BRIDGE_MODE=full

# Auto-watch directory for .bridge file hot-reload
# BRIDGE_WATCH_DIR=./

# Path to bridge.toml config file (default: ./bridge.toml)
# BRIDGE_CONFIG=./bridge.toml

# ── PostgreSQL (docker-compose) ─────────────────────────────────────────────────

POSTGRES_USER=bridge
POSTGRES_PASSWORD=bridge
POSTGRES_DB=bridge_dev
POSTGRES_PORT=5432

# Full connection URL (used by application code)
DATABASE_URL=postgres://bridge:bridge@localhost:5432/bridge_dev

# ── Redis (docker-compose external) ────────────────────────────────────────────
# Only needed when using docker-compose Redis instead of embedded miniredis

REDIS_PORT=6379
REDIS_MAX_MEMORY=64mb

# Full connection URL
REDIS_URL=redis://localhost:6379

# ── pgAdmin (docker-compose --profile full) ─────────────────────────────────────

PGADMIN_EMAIL=admin@bridge.local
PGADMIN_PASSWORD=bridge
PGADMIN_PORT=5050

# ── Redis Commander (docker-compose --profile full) ──────────────────────────────

REDIS_COMMANDER_PORT=8081

# ── Build / Debug ───────────────────────────────────────────────────────────────

# Rust log level: error | warn | info | debug | trace
# RUST_LOG=debug
