				w := httptest.NewRecorder()
				req := httptest.NewRequest("GET", "/di/one", nil)
				run.ServeHTTP(w, req)
				c.Assert(w.Code, qt.Equals, 200)
				c.Assert(w.Body.Bytes(), qt.HasLen, 0)
			}

			{
				w := httptest.NewRecorder()
				req := httptest.NewRequest("GET", "/di/two", nil)
				run.ServeHTTP(w, req)
				c.Assert(w.Code, qt.Equals, 200)
