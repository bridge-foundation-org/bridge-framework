mod helpers;

#[tokio::test]
async fn test_sadd() {
    let (m, mut c) = helpers::start().await;

    must_int!(c, "SADD", "s", "a", "b", "c"; 3);
    must_int!(c, "SCARD", "s"; 3);
    must_int!(c, "SADD", "s", "a", "b", "d"; 1); // only d is new

    // SMEMBERS
    must_strs_sorted!(c, "SMEMBERS", "s"; ["a", "b", "c", "d"]);

