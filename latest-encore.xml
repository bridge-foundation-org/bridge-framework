        GLOBALS.set(&globals, || {
            let ar = txtar::from_str(
                "
-- foo.ts --
import { Bar } from './bar.ts';

Bar.field;      // FieldAccess
Bar.method();   // MethodCall
Bar();          // Callee
foo(x, Bar)     // CallArg
new Class(Bar); // ConstructorArg
let foo = Bar;  // Other

// Inside nested function calls
const _ = nested(
  () => {
    bb.on('close', async () => {
      const _ = await Bar.nested_method();
    })
  }
)

