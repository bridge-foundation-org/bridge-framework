impl std::fmt::Debug for MetricStorage {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        f.debug_struct("MetricStorage")
            .field("atomic", &self.atomic)
            .field("registered_at", &self.registered_at)
            .finish()
    }
