func TestPubsubUnsub(t *testing.T) {
	skip(t)
	testRaw2(t, func(c1, c2 *client) {
		c1.Do("SUBSCRIBE", "news", "sport")
		c1.Receive()
		c2.DoSorted("PUBSUB", "CHANNELS")
		c1.Do("QUIT")
		c2.DoSorted("PUBSUB", "CHANNELS")
