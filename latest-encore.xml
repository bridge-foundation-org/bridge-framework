		{
			name: "unset_gauges",
			metric: metrics.CollectedMetric{
				Info:   metricInfo{"test_gauges", metrics.GaugeType, 0},
				Labels: []metrics.KeyValue{{"key", "value"}},
				Val:    []uint64{1, 0},
				Valid: func() []atomic.Bool {
					valid := make([]atomic.Bool, 2)
