//	func DoFoo(ctx context.Context) error {
//	  msgID, err := MyTopic.Publish(ctx, &MyEvent{Foo: "bar"})
//	  if err != nil { return err }
//	  rlog.Info("foo published", "message_id", msgID)
//	  return nil
//	}
