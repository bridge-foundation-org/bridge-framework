        self.tracer
            .trace(source, "insert before", true, &[&key], async || {
                let result = self.backend.linsert_before(&key, pivot, value, ttl).await;
                match result {
                    Ok(n) if n < 0 => Err(Error::Miss),
                    other => other,
                }
            })
            .await
    }

    /// Insert element after pivot in list.
    pub async fn linsert_after(
        &self,
        key: &str,
