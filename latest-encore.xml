            .trace(source, "set range", true, &[&key], async || {
                self.backend.set_range(&key, offset, value, ttl).await
            })
            .await
    }

    /// Get string length.
    pub async fn strlen(&self, key: &str, source: Option<&Request>) -> OpResult<i64> {
