        .query_async(&mut c)
        .await
        .unwrap();

    // XAUTOCLAIM with 0 min-idle-time (claims all pending)
    let result: redis::Value = redis::cmd("XAUTOCLAIM")
        .arg("s")
        .arg("g1")
        .arg("c2")
        .arg("0")
        .arg("0-0")
