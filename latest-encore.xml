    // SET should still return +OK
    let resp = raw_cmd(&mut stream, &["SET", "key", "value"]).await;
    assert_eq!(resp, b"+OK\r\n");

    // GET should return bulk string
    let resp = raw_cmd(&mut stream, &["GET", "key"]).await;
    assert_eq!(resp, b"$5\r\nvalue\r\n");

