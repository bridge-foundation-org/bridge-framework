      - pattern: |
          select {
          case <-ctx.Done():
              $BODY
          case <-time.After(...):
              $BODY
          }
      - pattern: |
          $T := time.NewTicker(...)
          ...
          select {
          case <-ctx.Done():
              $BODY
          case <-$T.C:
              $BODY
          }
