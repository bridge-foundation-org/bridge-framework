    #[test]
    fn test_scan_external_binds() {
        let globals = Globals::new();
        GLOBALS.set(&globals, || {
            let ar = txtar::from_str(
                "
-- foo.ts --
import { Bar } from './bar.ts';
-- bar.ts --
export const Bar = 5;
        ",
            );

            let base = PathBuf::from("/dummy");
            let resolver = Box::new(TestResolver::new(base.to_path_buf(), ar.clone()));
