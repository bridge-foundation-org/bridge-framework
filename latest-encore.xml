    must_fail!(c, "SWAPDB", "abc", "0"; "invalid first DB index");
    must_fail!(c, "SWAPDB", "0", "abc"; "invalid second DB index");
    must_fail!(c, "SWAPDB", "0", "99"; "DB index is out of range");
    must_fail!(c, "SWAPDB", "-1", "0"; "DB index is out of range");
}

