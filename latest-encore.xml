#[allow(non_snake_case)]
#[derive(LitParser, Default, Debug)]
struct DecodedClusterConfig {
    #[allow(dead_code)]
    evictionPolicy: Option<Sp<String>>,
}

#[allow(non_snake_case)]
#[derive(LitParser, Debug)]
struct DecodedKeyspaceConfig {
