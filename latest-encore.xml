	tb.UVarint(uint64(len(headers)))
	for k, v := range headers {
		firstVal := ""
		if scrubHeaders[k] {
			firstVal = "[REDACTED]"
		} else if len(v) > 0 {
			firstVal = v[0]
		}
		tb.String(k)
		tb.String(firstVal)
	}
}

