            .map_err(|e| PrepareError::Internal(e.into()))?;

        Ok(Self { name })
    }

    fn render(&self, reg: &Handlebars, data: &impl Serialize) -> Result<String, PrepareError> {
        reg.render(self.name, data)
            .map_err(|e| PrepareError::Internal(e.into()))
    }
}

